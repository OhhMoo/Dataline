.env
.env.*
*.token
*credentials*

# --- python ------------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/

# --- os ----------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# --- build artifacts (v1 onward) ---------------------------------------------
# World images and warehouses are regenerated from seeds; committing them
# defeats the point of bit-reproducible resets.
*.duckdb
*.duckdb.wal
*.db-journal
data/raw/
.tmp/
scratch/

