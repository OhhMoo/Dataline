.coverage
.coverage.*
htmlcov/
*.egg-info/
build/
dist/
.direnv/
.idea/
.vscode/
*.swp
*~
*.orig
*.rej
*.log

# --- built world roots -------------------------------------------------------
# A built world materialises var/{warehouse,sched,obs,ingest,world}. Worlds are
# rebuilt from seeds and are fingerprinted, never committed. No tracked path
# contains a var/ segment - checked before adding this rule.
var/

# -----------------------------------------------------------------------------
# LINE ENDINGS ARE A FINGERPRINT INPUT - see .gitattributes (`* text=auto eol=lf`).
# build.py copies themes/*/workspace byte-for-byte into the world and
# fingerprint.py hashes those bytes, so a checkout whose line endings differ from
# a clone's produces a DIFFERENT workspace hash. Measured on revenue_daily:
# as-is eefdae93..., as cloned 48eda34a.... Gate 3 cannot catch this - it builds
# twice from ONE tree, where the CR is present in both. Never relax .gitattributes.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# DELIBERATELY NOT IGNORED - these ARE the research record:
#   docs/implementation_plan/structure/state/**    the blackboard, including failures/
#   docs/implementation_plan/structure/rounds/**   per-round reports and gate output
#   _archive/verifier/runs/**               append-only verification history
#   gateway/docker/evidence/**          containment / toolbelt / image proofs
#   tasks/harness/evidence/**           rollout and container-check evidence
#   world/evidence/**               acceptance.sh's all-pass record (host == container hash, gate 7)
#   gateway/requirements*.lock, gateway/uv.lock   pinned deps; determinism and the image depend on them
#   */README.md                      the per-folder guide (each folder folds its former OVERVIEW.md
#                                    and contract docs into it)
#
# state/failures/ in particular must be committed. It exists so a later round does
# not rediscover what an earlier one already killed. Ignoring it would silently
# delete the most expensive thing the swarm produced.
# -----------------------------------------------------------------------------

# Vendored upstream repos (clone, don't commit)
vendor/
tasks/**/tests/fixtures/build/

# --- test / process debris (added 2026-09-16) ------------------------------
.hypothesis/
nohup.out
*.pid

# local working status, not committed
STATUS.md

# the public per-run artefact (export.py): regenerate with --export, never commit
benchmark.json

# agent tooling state (superpowers plugin: sdd working dirs, generated plans)
# .superpowers/sdd/.gitignore already self-ignores; this pins intent at root.
.superpowers/
docs/superpowers/

# Private notes: prep for conversations, answers being drafted for a
# collaborator, anything not meant to live in the shared repo. Keep them in
# docs/private/, or name them *.private.md / *for_andrew*.md / FOR_*.md
# anywhere and they stay local.
docs/private/
*.private.md
*[Ff]or_[Aa]ndrew*.md
**/FOR_*.md

# Claude Code agent worktrees
.claude/worktrees/

# Harbor export (harbor/export.py): generated datasets are build artifacts,
# regenerated from the generator + templates. Never commit them.
harbor/dist/

# Local experiment plan markdown files and scratch symlinks
experiments/**/plan*.md
experiments/desaturation_20261017
experiments/scale_1000/output
autoresearch/


