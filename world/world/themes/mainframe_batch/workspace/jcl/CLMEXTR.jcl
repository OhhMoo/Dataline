//CLMEXTR  JOB (ACCT),'CLAIMS EXTRACT',CLASS=A,MSGCLASS=X,
//             MSGLEVEL=(1,1),NOTIFY=&SYSUID,REGION=0M
//*
//* ------------------------------------------------------------------
//* NIGHTLY CLAIMS EXTRACT - POLICYMASTER
//*
//* REFERENCE COPY ONLY. THE AUTHORITATIVE MEMBER IS IN THE MAINFRAME
//* PROCLIB ON PLEX1. THIS COPY IS HELD HERE SO THAT THE RECORD LAYOUT
//* IN COPYBOOKS/CLAIMS.CPY CAN BE READ NEXT TO THE JOB THAT PRODUCES
//* IT. EDITING THIS FILE CHANGES NOTHING ON THE HOST.
//*
//* STEP010  EXTRACT CLAIMS ACTIVITY FOR THE PRECEDING DAY
//* STEP020  TRANSMIT TO THE DISTRIBUTED LANDING ZONE VIA NDM
//*
//* CHANGE CONTROL  CR-2024-077  TRANSMISSION MOVED FTP -> NDM
//*                 CR-2025-203  SETTLE WINDOW 30 -> 45 MINUTES
//* ------------------------------------------------------------------
//*
//STEP010  EXEC PGM=CLMEXT01,PARM='&YYMMDD'
//STEPLIB  DD DSN=PROD.POLICYMSTR.LOADLIB,DISP=SHR
//CLAIMIN  DD DSN=PROD.POLICYMSTR.CLAIMS,DISP=SHR
//CLAIMOUT DD DSN=PROD.EXTRACT.CLAIMS(+1),
//            DISP=(NEW,CATLG,DELETE),
//            UNIT=SYSDA,SPACE=(CYL,(50,10),RLSE),
//            DCB=(RECFM=FB,LRECL=31,BLKSIZE=31000)
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//*
//* A NON-ZERO RETURN FROM STEP010 MUST NOT TRANSMIT. THE DISTRIBUTED
//* SIDE CANNOT TELL A SHORT EXTRACT FROM A SMALL ONE.
//*
//STEP020  EXEC PGM=NDMBATCH,COND=(0,NE,STEP010)
//STEPLIB  DD DSN=PROD.CDIRECT.LOADLIB,DISP=SHR
//DMNETMAP DD DSN=PROD.CDIRECT.NETMAP,DISP=SHR
//DMPUBLIB DD DSN=PROD.CDIRECT.PROCESS,DISP=SHR
//SYSIN    DD *
  SUBMIT PROC=CLMSEND  &DSN=PROD.EXTRACT.CLAIMS(0) -
                       &RNODE=DISTLZ01
/*
//SYSPRINT DD SYSOUT=*
//
