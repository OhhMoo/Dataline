# ---------------------------------------------------------------------------
# Environment overlay, held in the repository under change control.
#
# Site configuration is conf/claims.cfg. This file carries only the two values
# that legitimately vary per workstation, and it carries no credentials: the
# batch node's environment is set by the scheduling system and does not read
# this file.
#
# run.sh sources this file directly, so direnv is not required.
#
# Reviewed: CR-2026-014
# ---------------------------------------------------------------------------

export DBT_TARGET="${DBT_TARGET:-dev}"

# Leave unset to use conf/claims.cfg [warehouse] path_default.
# export DBT_WAREHOUSE_PATH=

# Workstation overrides, not under change control and not committed.
if [ -f .env ]; then
  set -a
  . ./.env
  set +a
fi
