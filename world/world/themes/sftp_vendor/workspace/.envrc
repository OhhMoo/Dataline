# direnv. committed. no secrets in here - the vault entries are named in
# config/vendors.yml and the pull cron on the edge box is what reads them.
#
# ./run.sh sources this itself, so you do not need direnv installed.

export DBT_TARGET="${DBT_TARGET:-dev}"

# where the sftp mirror drops files. the actual sftp pull is a separate cron on
# the edge box, not this repo.
export DROP_ROOT="${DROP_ROOT:-data/drop}"

# snowflake (prod target in config/profiles.yml). don't bother: the dev
# account was decommissioned and nobody has rebuilt it. stay on target=dev.
# these are read from the vault on the deployment, never from here.
export SNOWFLAKE_ACCOUNT="${SNOWFLAKE_ACCOUNT:-}"
export SNOWFLAKE_USER="${SNOWFLAKE_USER:-}"
export SNOWFLAKE_PRIVATE_KEY_PATH="${SNOWFLAKE_PRIVATE_KEY_PATH:-}"

# key paths for the pull cron, which is NOT in this repo. kept for the day we
# move it in. the keys themselves live under ~/.ssh on the edge box.
export ACME_SFTP_KEY_PATH="${ACME_SFTP_KEY_PATH:-}"
# GLOBEX_SFTP_KEY_PATH dropped 2026-02: globex moved to the shared acme key
# when they re-onboarded. config/vendors.yml still lists a globex key path.
# one of the two is wrong and it has not mattered because nothing here reads
# either of them.

# your own stuff goes in .env, which is gitignored. `if`, not `&&`: this
# file is sourced by run.sh under `set -e`, and a trailing `&&` test that
# fails makes the whole source return non-zero and kills the caller.
if [ -f .env ]; then
  set -a
  . ./.env
  set +a
fi
