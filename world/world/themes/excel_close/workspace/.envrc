# direnv. Committed: none of this is a secret. The share path and the
# controller's address are not confidential and the close laptop needs them to
# resolve without anyone hand-editing a file at month end.
#
# ./run.sh sources this itself; direnv is not installed on the close laptop.

export DBT_TARGET="${DBT_TARGET:-dev}"
# export DBT_WAREHOUSE_PATH=

# Where the GL team keeps the workbooks. The repo copy under
# finance/workbooks/ is what the import reads; this is the share it is synced
# from, and the sync is manual.
export CLOSE_SHARE_PATH="${CLOSE_SHARE_PATH:-//fileserver/finance/close}"

export CONTROLLER_EMAIL="${CONTROLLER_EMAIL:-controller@example.invalid}"
export GL_TEAM_EMAIL="${GL_TEAM_EMAIL:-gl-team@example.invalid}"

# Materiality threshold for the variance review, in currency units.
# Finance raised this to 10000 for FY26. config/close.yml still says 5000 and
# the BI variance panel reads that file. Unresolved since January; the
# checklist tells you which one to use.
export MATERIALITY_THRESHOLD="${MATERIALITY_THRESHOLD:-10000}"

# `if`, not `&&`: run.sh sources this under `set -e`, and a trailing test
# that fails would make the source return non-zero and kill the caller.
if [ -f .env ]; then
  set -a
  . ./.env
  set +a
fi
