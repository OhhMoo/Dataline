# direnv. committed - no secrets in here. Tokens for the BI tools come from
# the vault in CI and are never needed locally.
#
# ./run.sh sources this itself, so you do not need direnv installed.

export DBT_TARGET="${DBT_TARGET:-dev}"

# where the shop platform's export job drops the nightly extract
export LANDING_ROOT="${LANDING_ROOT:-data/landing}"

# BI release targets (ae/runbooks/bi-release-process). CI reads these; you only
# need them to run tabcmd or the Sigma export by hand.
export PBI_DEPLOYMENT_PIPELINE="${PBI_DEPLOYMENT_PIPELINE:-Commerce Analytics}"
export TABLEAU_SITE="${TABLEAU_SITE:-commerce}"
export SIGMA_WORKSPACE="${SIGMA_WORKSPACE:-Commerce}"

# your own overrides go in .env, which is gitignored. `if`, not `&&`: run.sh
# sources this under `set -e`, and a failing trailing test would kill it.
if [ -f .env ]; then
  set -a
  . ./.env
  set +a
fi

# >>> platform-managed: service endpoints. Regenerated on provision. >>>
# Everything below is written by the platform when the box is
# provisioned. The tokens are local development tokens; the real ones
# come from the vault and are injected by the deployment.

# The notebook server.
export JUPYTER_URL="http://jupyter.internal:8888"

# Where a bare `dbt` finds its profile.
export DBT_PROFILES_DIR="/root/.dbt"

# jira - the ticket queue
export JIRA_URL="http://jira.internal:8080"
export JIRA_USER="alkera-local-dev"
export JIRA_API_TOKEN="alkera-local-dev"

# slack - the team channels
export SLACK_BASE_URL="http://slack.internal:8081"
export SLACK_BOT_TOKEN="alkera-local-dev"

# confluence - the wiki: runbooks, postmortems, policies
export CONFLUENCE_URL="http://confluence.internal:8090"
export CONFLUENCE_USER="alkera-local-dev"
export CONFLUENCE_API_TOKEN="alkera-local-dev"

# powerbi - Power BI: published semantic models, refreshes, DAX queries
export POWERBI_API_URL="http://powerbi.internal:8095"
export FABRIC_API_URL="http://powerbi.internal:8095"
export AZURE_AUTHORITY_HOST="http://powerbi.internal:8095"
export AZURE_CLIENT_ID="alkera-local-dev"
export AZURE_CLIENT_SECRET="alkera-local-dev"
export AZURE_TENANT_ID="alkera-local-dev"

# tableau - Tableau Server: published data sources, workbooks, extracts
export TABLEAU_SERVER_URL="http://tableau.internal:8096"
export TABLEAU_PAT_NAME="alkera-local-dev"
export TABLEAU_PAT_SECRET="alkera-local-dev"
export TABLEAU_SITE=""

# sigma - Sigma: published workbooks, data models, connections
export SIGMA_BASE_URL="http://sigma.internal:8097"
export SIGMA_CLIENT_ID="alkera-local-dev"
export SIGMA_CLIENT_SECRET="alkera-local-dev"

# <<< platform-managed: service endpoints <<<
