# >>> platform-managed: service endpoints. Regenerated on provision. >>>
# Everything below is written by the platform when the box is
# provisioned. The tokens are local development tokens; the real ones
# come from the vault and are injected by the deployment.

# The warehouse. psql and psycopg need no arguments with these set.
export PGDATABASE="alkera"
export PGHOST="postgres.internal"
export PGPASSWORD="alkera-local-dev"
export PGPORT="5432"
export PGUSER="alkera"

# Object storage. `aws s3 ls` and boto3 resolve through this endpoint.
export AWS_ACCESS_KEY_ID="alkera-local-dev"
export AWS_DEFAULT_REGION="us-east-1"
export AWS_ENDPOINT_URL="http://minio.internal:9000"
export AWS_SECRET_ACCESS_KEY="alkera-local-dev"

# The scheduler.
export AIRFLOW_API_URL="http://airflow.internal:8080/api/v2"
export AIRFLOW_PASSWORD="alkera-local-dev"
export AIRFLOW_USER="alkera-local-dev"

# The second warehouse.
export SNOWFLAKE_ACCOUNT="acme"
export SNOWFLAKE_HOST="snowflake.internal"
export SNOWFLAKE_PASSWORD="alkera-local-dev"
export SNOWFLAKE_USER="alkera-local-dev"

# Where a bare `dbt` finds its profile.
export DBT_PROFILES_DIR="/root/.dbt"

# metabase - dashboards and saved questions
export METABASE_URL="http://metabase.internal:3000"
export METABASE_API_KEY="alkera-local-dev"

# loki - job logs; logcli reads LOKI_ADDR
export LOKI_URL="http://loki.internal:3100"
export LOKI_ADDR="http://loki.internal:3100"

# jira - the ticket queue
export JIRA_URL="http://jira.internal:8080"
export JIRA_USER="alkera-local-dev"
export JIRA_API_TOKEN="alkera-local-dev"

# slack - the team channels
export SLACK_BASE_URL="http://slack.internal:8081"
export SLACK_BOT_TOKEN="alkera-local-dev"

# airbyte - connector control plane
export AIRBYTE_URL="http://airbyte.internal:8001"
export AIRBYTE_API_KEY="alkera-local-dev"

# deploy - releases; ops/deploy wraps it
export DEPLOY_URL="http://deploy.internal:8085"
export DEPLOY_API_TOKEN="alkera-local-dev"

# confluence - the wiki: runbooks, postmortems, policies
export CONFLUENCE_URL="http://confluence.internal:8090"
export CONFLUENCE_USER="alkera-local-dev"
export CONFLUENCE_API_TOKEN="alkera-local-dev"

# prometheus - metrics
export PROMETHEUS_URL="http://prometheus.internal:9090"

# alertmanager - alarms
export ALERTMANAGER_URL="http://alertmanager.internal:9093"

# <<< platform-managed: service endpoints <<<
